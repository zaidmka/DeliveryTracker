@page "/scan"
@attribute [Authorize]
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using DeliveryTracker.Shared.Dtos.Shops
@using DeliveryTracker.Shared.Dtos.Items
@using DeliveryTracker.Shared.Dtos.Deliveries
@using DeliveryTracker.Services.Items
@using DeliveryTracker.Services.Deliveries

@inject IDeliveryService DeliveryService
@inject IItemService ItemService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>تسجيل تسليم | DeliveryTracker</PageTitle>

<div class="scan-page" dir="rtl">
    <div class="scan-shell">
        <header class="scan-hero">
            <div class="scan-eyebrow"><i class="bi bi-box-seam"></i> إدارة التوزيع <span class="scan-eyebrow-dot"></span> تسجيل ميداني</div>
            <div class="scan-hero-main">
                <div>
                    <h1>تسجيل تسليم <span>جديد</span></h1>
                    <p>امسح رمز المحل، حدّد الكميات، وأكّد التسليم بخطوات بسيطة.</p>
                </div>
                <div class="scan-hero-icon"><i class="bi bi-qr-code-scan"></i></div>
            </div>
        </header>

        <div class="scan-steps" aria-label="مراحل التسليم">
            <div class="scan-step @(shop is not null ? "done" : "current")"><span>1</span> مسح المحل</div>
            <i class="bi bi-chevron-left"></i>
            <div class="scan-step @(shop is not null && !savedDeliveryId.HasValue ? "current" : savedDeliveryId.HasValue ? "done" : "")"><span>2</span> تحديد المواد</div>
            <i class="bi bi-chevron-left"></i>
            <div class="scan-step @(savedDeliveryId.HasValue ? "done" : "")"><span>3</span> التأكيد</div>
        </div>

        @if (loading)
        {
            <div class="scan-panel scan-centered" role="status">
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <h3>جاري تحميل بيانات المحل...</h3>
                <p>يرجى الانتظار قليلاً</p>
            </div>
        }
        else if (savedDeliveryId.HasValue && shop is not null)
        {
            <div class="scan-panel scan-centered scan-success">
                <div class="scan-success-icon"><i class="bi bi-check-lg"></i></div>
                <h2>تم تسجيل التسليم بنجاح!</h2>
                <p>تم حفظ عملية التسليم إلى <strong>@shop.Name</strong></p>
                <div class="scan-receipt"><span>رقم عملية التسليم</span><strong>#@savedDeliveryId</strong></div>
                <div class="scan-actions-center">
                    <button type="button" class="scan-btn scan-btn-primary" @onclick="StartAnother"><i class="bi bi-arrow-repeat"></i> تسليم آخر لنفس المحل</button>
                    <button type="button" class="scan-btn scan-btn-soft" @onclick="ScanAnotherShop"><i class="bi bi-qr-code-scan"></i> مسح محل آخر</button>
                </div>
            </div>
        }
        else if (shop is null)
        {
            <div class="scan-panel scan-centered scan-welcome">
                <div class="scan-illustration"><i class="bi bi-qr-code-scan"></i><span><i class="bi bi-camera-fill"></i></span></div>
                <h2>جاهز لمسح رمز المحل؟</h2>
                <p>وجّه كاميرا هاتفك نحو رمز QR الموجود لدى المحل للبدء.</p>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="scan-alert scan-alert-danger" role="alert"><i class="bi bi-exclamation-triangle"></i> @error</div>
                }
                <button type="button" class="scan-btn scan-btn-primary scan-btn-big" @onclick="OpenCameraAsync" disabled="@cameraBusy">
                    <i class="bi bi-camera"></i> @(cameraBusy ? "جاري تشغيل الكاميرا..." : "فتح الكاميرا ومسح QR")
                </button>
                <div class="scan-hint"><i class="bi bi-shield-check"></i> يتطلب استخدام الكاميرا إذنك، واتصال HTTPS</div>
            </div>
        }
        else
        {
            <section class="scan-panel scan-shop">
                <div class="scan-shop-icon"><i class="bi bi-shop-window"></i></div>
                <div class="scan-shop-info">
                    <span class="scan-kicker">المحل المحدد <i class="bi bi-patch-check-fill"></i></span>
                    <h2>@shop.Name</h2>
                    <div class="scan-shop-meta">
                        <span><i class="bi bi-upc-scan"></i> @shop.Code</span>
                        @if (!string.IsNullOrWhiteSpace(shop.Address))
                        {
                            <span><i class="bi bi-geo-alt"></i> @shop.Address</span>
                        }
                    </div>
                </div>
                <button type="button" class="scan-icon-btn" title="مسح محل آخر" aria-label="مسح محل آخر" @onclick="ScanAnotherShop"><i class="bi bi-arrow-repeat"></i></button>
            </section>

            <section class="scan-section">
                <div class="scan-section-heading">
                    <div><span class="scan-kicker">تفاصيل العملية</span><h2>المواد المسلّمة</h2></div>
                    <span class="scan-counter">@SelectedCount من @items.Count مادة</span>
                </div>
                @if (items.Count == 0)
                {
                    <div class="scan-alert scan-alert-warning"><i class="bi bi-info-circle"></i> لا توجد مواد فعالة متاحة للتسليم.</div>
                }
                else
                {
                    <div class="scan-items">
                        @foreach (var item in items)
                        {
                            <div class="scan-item @(quantities.GetValueOrDefault(item.Id) > 0 ? "scan-item-active" : "")" @key="item.Id">
                                <div class="scan-item-icon"><i class="bi bi-box-seam"></i></div>
                                <div class="scan-item-text">
                                    <strong>@item.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <small>@item.Description</small>
                                    }
                                </div>
                                <div class="scan-qty">
                                    <label for="qty-@item.Id">الكمية</label>
                                    <div class="scan-qty-controls">
                                        <button type="button" aria-label="تقليل كمية @item.Name" disabled="@(quantities.GetValueOrDefault(item.Id) == 0 || saving)" @onclick="() => ChangeQuantity(item.Id, -1)"><i class="bi bi-dash"></i></button>
                                        <input id="qty-@item.Id" type="number" min="0" step="1" inputmode="numeric" value="@quantities[item.Id]" disabled="@saving" @onchange="e => SetQuantity(item.Id, e.Value?.ToString())" />
                                        <button type="button" aria-label="زيادة كمية @item.Name" disabled="@saving" @onclick="() => ChangeQuantity(item.Id, 1)"><i class="bi bi-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="scan-panel scan-notes">
                <label for="deliveryNotes"><i class="bi bi-chat-left-text"></i> ملاحظات التسليم <span>(اختياري)</span></label>
                <textarea id="deliveryNotes" rows="3" maxlength="500" @bind="notes" disabled="@saving" placeholder="أضف أي تفاصيل أو ملاحظات تخص هذه العملية..."></textarea>
            </section>

            <section class="scan-panel scan-summary">
                <div class="scan-section-heading"><div><span class="scan-kicker">مراجعة سريعة</span><h2>ملخص التسليم</h2></div><i class="bi bi-receipt"></i></div>
                <div class="scan-summary-row"><span>عدد أنواع المواد</span><strong>@SelectedCount</strong></div>
                <div class="scan-summary-row scan-summary-total"><span>إجمالي القطع</span><strong>@TotalQuantity</strong></div>
                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <div class="scan-alert scan-alert-danger" role="alert"><i class="bi bi-exclamation-triangle"></i> @saveError</div>
                }
                <button type="button" class="scan-btn scan-btn-primary scan-submit" disabled="@(saving || SelectedCount == 0)" @onclick="SaveDeliveryAsync">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>جاري حفظ التسليم...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i><span>تأكيد وحفظ التسليم</span><i class="bi bi-arrow-left scan-submit-arrow"></i>
                    }
                </button>
            </section>
        }
    </div>
</div>

@if (cameraOpen)
{
    <div class="scan-modal-backdrop" @onclick="CloseCameraAsync">
        <div class="scan-modal" role="dialog" aria-modal="true" aria-label="مسح رمز QR" @onclick:stopPropagation="true">
            <div class="scan-modal-header"><div><strong>مسح رمز QR</strong><small>وجّه الكاميرا نحو رمز المحل</small></div><button type="button" @onclick="CloseCameraAsync" aria-label="إغلاق"><i class="bi bi-x-lg"></i></button></div>
            <div id="delivery-qr-reader" class="scan-reader"></div>
            @if (!string.IsNullOrWhiteSpace(cameraError))
            {
                <div class="scan-alert scan-alert-danger" role="alert">@cameraError</div>
            }
            <div class="scan-modal-footer"><i class="bi bi-lightbulb"></i> تأكد من وضوح الرمز والإضاءة المناسبة.</div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ShopDto? shop;
    private List<ItemDto> items = new();
    private Dictionary<int, int> quantities = new();
    private bool loading, saving, cameraOpen, cameraBusy, cameraStartPending;
    private string? error, saveError, cameraError, notes, loadedToken;
    private int? savedDeliveryId;
    private DotNetObjectReference<Scan>? dotNetRef;
    private bool disposed;

    private int SelectedCount => quantities.Count(x => x.Value > 0);
    private long TotalQuantity => quantities.Values.Sum(x => (long)x);

    protected override async Task OnParametersSetAsync()
    {
        if (Token == loadedToken) return;
        loadedToken = Token;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = saveError = null;
        savedDeliveryId = null;
        shop = null;
        items.Clear();
        quantities.Clear();
        notes = null;
        try
        {
            if (string.IsNullOrWhiteSpace(Token)) return;
            if (!Guid.TryParse(Token, out var qrToken) || qrToken == Guid.Empty)
            {
                error = "رمز QR غير صالح. حاول مسح الرمز مجدداً.";
                return;
            }
            shop = await DeliveryService.GetShopByQrAsync(qrToken);
            if (shop is null)
            {
                error = "المحل غير موجود أو غير فعال.";
                return;
            }
            items = await ItemService.GetAllAsync(activeOnly: true);
            quantities = items.ToDictionary(x => x.Id, _ => 0);
        }
        catch (Exception)
        {
            error = "تعذر تحميل بيانات المحل أو المواد. حاول مرة أخرى.";
        }
        finally { loading = false; }
    }

    private void SetQuantity(int itemId, string? value)
    {
        if (!quantities.ContainsKey(itemId)) return;
        if (!int.TryParse(value, out var quantity) || quantity < 0) quantity = 0;
        quantities[itemId] = quantity;
    }

    private void ChangeQuantity(int itemId, int delta)
    {
        if (!quantities.TryGetValue(itemId, out var current)) return;
        if (delta > 0 && current == int.MaxValue) return;
        quantities[itemId] = Math.Max(0, current + delta);
    }

    private Task OpenCameraAsync()
    {
        if (cameraBusy || cameraOpen) return Task.CompletedTask;
        cameraError = null;
        cameraOpen = true;
        cameraBusy = true;
        cameraStartPending = true;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!cameraStartPending || !cameraOpen) return;
        cameraStartPending = false;
        try
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("deliveryQrScanner.start", "delivery-qr-reader", dotNetRef);
        }
        catch (Exception)
        {
            cameraError = "تعذر تشغيل الكاميرا. تأكد من إذن الكاميرا وHTTPS واتصال الإنترنت لتحميل مكتبة المسح.";
        }
        finally
        {
            cameraBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CloseCameraAsync()
    {
        if (!cameraOpen) return;
        try { await JS.InvokeVoidAsync("deliveryQrScanner.stop"); }
        catch (JSException) { }
        cameraOpen = false;
        cameraBusy = false;
        cameraStartPending = false;
    }

    [JSInvokable]
    public async Task OnQrDetected(string qrText)
    {
        if (disposed) return;
        string? token = null;
        if (Guid.TryParse(qrText.Trim(), out var directToken)) token = directToken.ToString();
        else if (Uri.TryCreate(qrText.Trim(), UriKind.Absolute, out var uri))
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("token", out var values) && Guid.TryParse(values.ToString(), out var parsed))
                token = parsed.ToString();
        }
        if (token is null)
        {
            cameraError = "الرمز المقروء لا يحتوي على Token صالح للمحل.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        await CloseCameraAsync();
        await InvokeAsync(() => Navigation.NavigateTo($"/scan?token={Uri.EscapeDataString(token)}"));
    }

    private async Task SaveDeliveryAsync()
    {
        if (saving || shop is null || SelectedCount == 0) return;
        saving = true;
        saveError = null;
        try
        {
            var request = new CreateDeliveryRequest
            {
                ShopQrToken = shop.QrToken,
                Notes = notes,
                Items = quantities.Where(x => x.Value > 0)
                    .Select(x => new CreateDeliveryItemRequest { ItemTypeId = x.Key, Quantity = x.Value }).ToList()
            };
            savedDeliveryId = await DeliveryService.CreateAsync(request);
        }
        catch (Exception ex) { saveError = ex.Message; }
        finally { saving = false; }
    }

    private void StartAnother()
    {
        savedDeliveryId = null;
        saveError = notes = null;
        foreach (var id in quantities.Keys.ToList()) quantities[id] = 0;
    }

    private void ScanAnotherShop() => Navigation.NavigateTo("/scan", forceLoad: false);

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        try { await JS.InvokeVoidAsync("deliveryQrScanner.stop"); }
        catch (Exception) { }
        dotNetRef?.Dispose();
    }
}
