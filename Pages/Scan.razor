@page "/scan"
@attribute [Authorize]
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using DeliveryTracker.Shared.Dtos.Shops
@using DeliveryTracker.Shared.Dtos.Items
@using DeliveryTracker.Shared.Dtos.Deliveries
@using DeliveryTracker.Services.Items
@using DeliveryTracker.Services.Deliveries

@inject IDeliveryService DeliveryService
@inject IItemService ItemService

<PageTitle>تسجيل تسليم - DeliveryTracker</PageTitle>

<div class="container-fluid py-3" dir="rtl">

    <div class="mb-4">
        <div class="text-primary small fw-semibold mb-1">
            <i class="bi bi-qr-code-scan ms-1"></i>
            عمليات التوزيع
        </div>
        <h3 class="fw-bold mb-1">تسجيل تسليم</h3>
        <p class="text-muted small mb-0">
            امسح رمز المحل، ثم أدخل الكميات المسلّمة.
        </p>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="text-muted mt-3">جاري تحميل البيانات...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger rounded-4">
            <i class="bi bi-exclamation-circle ms-1"></i>
            @error
        </div>
    }
    else if (shop is null)
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-qr-code-scan text-primary"
                   style="font-size: 55px;"></i>

                <h5 class="fw-bold mt-3">بانتظار مسح QR</h5>
                <p class="text-muted small">
                    افتح كاميرا الموبايل وامسح رمز المحل.
                </p>

                <div class="text-muted small">
                    أو أدخل رابط QR الخاص بالمحل في المتصفح.
                </div>
            </div>
        </div>
    }
    else if (savedDeliveryId.HasValue)
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle-fill text-success"
                   style="font-size: 65px;"></i>

                <h4 class="fw-bold mt-3">تم تسجيل التسليم بنجاح</h4>

                <p class="text-muted">
                    @shop.Name
                </p>

                <div class="bg-light rounded-3 p-3 mb-4">
                    رقم عملية التسليم
                    <div class="fs-3 fw-bold">
                        #@savedDeliveryId
                    </div>
                </div>

                <button class="btn btn-primary rounded-3"
                        @onclick="StartAnother">
                    تسجيل تسليم آخر لنفس المحل
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-shop fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">@shop.Name</h5>
                        <div class="text-muted small">@shop.Code</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(shop.Address))
                {
                    <div class="text-muted small mt-3">
                        <i class="bi bi-geo-alt ms-1"></i>
                        @shop.Address
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">المواد المسلّمة</h5>
            <span class="badge bg-primary rounded-pill">
                @SelectedCount مادة
            </span>
        </div>

        @if (quantities.Count == 0)
        {
            <div class="alert alert-warning">
                لا توجد مواد فعالة متاحة للتسليم.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2 mb-3">
                @foreach (var item in items)
                {
                    <div class="card border-0 shadow-sm rounded-4"
                         @key="item.Id">
                        <div class="card-body d-flex align-items-center justify-content-between gap-3">

                            <div class="flex-grow-1">
                                <div class="fw-bold">@item.Name</div>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="text-muted small mt-1">
                                        @item.Description
                                    </div>
                                }
                            </div>

                            <div style="width: 105px;">
                                <label class="form-label text-muted small mb-1">
                                    الكمية
                                </label>

                                <input type="number"
                                       class="form-control text-center"
                                       min="0"
                                       step="1"
                                       inputmode="numeric"
                                       value="@quantities[item.Id]"
                                       @onchange="e => SetQuantity(item.Id, e.Value?.ToString())" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <label class="form-label fw-semibold">ملاحظات (اختياري)</label>
                <textarea class="form-control"
                          rows="3"
                          maxlength="500"
                          @bind="notes"
                          placeholder="أي ملاحظة تخص التسليم..."></textarea>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <div class="alert alert-danger">@saveError</div>
        }

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">المواد المحددة</span>
                    <strong>@SelectedCount</strong>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">مجموع القطع</span>
                    <strong>@TotalQuantity</strong>
                </div>

                <button class="btn btn-primary w-100 py-3 rounded-3 fw-bold"
                        disabled="@(saving || SelectedCount == 0)"
                        @onclick="SaveDeliveryAsync">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm ms-2"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle ms-2"></i>
                        <span>تأكيد وحفظ التسليم</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ShopDto? shop;
    private List<ItemDto> items = new();
    private Dictionary<int, int> quantities = new();

    private bool loading;
    private bool saving;
    private string? error;
    private string? saveError;
    private string? notes;
    private int? savedDeliveryId;

    private string? loadedToken;
    private bool disposed;

    private int SelectedCount =>
        quantities.Count(x => x.Value > 0);

    private int TotalQuantity =>
        quantities.Values.Sum();

    protected override async Task OnParametersSetAsync()
    {
        if (Token == loadedToken)
            return;

        loadedToken = Token;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        saveError = null;
        savedDeliveryId = null;
        shop = null;
        items.Clear();
        quantities.Clear();
        notes = null;

        try
        {
            if (string.IsNullOrWhiteSpace(Token))
                return;

            if (!Guid.TryParse(Token, out var qrToken) ||
                qrToken == Guid.Empty)
            {
                error = "رمز QR غير صالح";
                return;
            }

            shop = await DeliveryService.GetShopByQrAsync(qrToken);

            if (shop is null)
            {
                error = "المحل غير موجود أو غير فعال";
                return;
            }

            items = await ItemService.GetAllAsync(activeOnly: true);

            quantities = items.ToDictionary(x => x.Id, _ => 0);
        }
        catch (Exception)
        {
            error = "تعذر تحميل بيانات المحل أو المواد.";
        }
        finally
        {
            loading = false;
        }
    }

    private void SetQuantity(int itemId, string? value)
    {
        if (!quantities.ContainsKey(itemId))
            return;

        if (!int.TryParse(value, out var quantity) || quantity < 0)
            quantity = 0;

        quantities[itemId] = quantity;
    }

    private async Task SaveDeliveryAsync()
    {
        if (saving || shop is null || SelectedCount == 0)
            return;

        saving = true;
        saveError = null;

        try
        {
            var request = new CreateDeliveryRequest
            {
                ShopQrToken = shop.QrToken,
                Notes = notes,
                Items = quantities
                    .Where(x => x.Value > 0)
                    .Select(x => new CreateDeliveryItemRequest
                    {
                        ItemTypeId = x.Key,
                        Quantity = x.Value
                    })
                    .ToList()
            };

            savedDeliveryId =
                await DeliveryService.CreateAsync(request);
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void StartAnother()
    {
        savedDeliveryId = null;
        saveError = null;
        notes = null;

        foreach (var id in quantities.Keys.ToList())
            quantities[id] = 0;
    }

    public void Dispose()
    {
        disposed = true;
    }
}
