@page "/items"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using DeliveryTracker.Shared.Dtos.Items
@using DeliveryTracker.Services.Items

@inject IItemService ItemService
@inject AuthenticationStateProvider AuthProvider

<PageTitle>إدارة المواد</PageTitle>

<div class="container-fluid py-3" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="fw-bold mb-1">إدارة المواد</h3>
            <div class="text-muted small">تعريف المواد المستخدمة في التوزيع</div>
        </div>

        @if (isAdmin)
        {
            <button class="btn btn-primary rounded-3"
                    @onclick="OpenCreate">
                <i class="bi bi-plus-lg ms-1"></i>
                إضافة مادة
            </button>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small mb-1">إجمالي المواد</div>
                    <h3 class="fw-bold mb-0">@items.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small mb-1">المواد الفعالة</div>
                    <h3 class="fw-bold text-success mb-0">
                        @items.Count(x => x.IsActive)
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-4">
        <div class="col-12 col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white border-start-0">
                    <i class="bi bi-search"></i>
                </span>
                <input class="form-control border-end-0"
                       placeholder="ابحث عن مادة..."
                       @bind="search"
                       @bind:event="oninput" />
            </div>
        </div>

        <div class="col-12 col-md-4">
            <select class="form-select" @bind="filter">
                <option value="all">جميع المواد</option>
                <option value="active">الفعالة</option>
                <option value="inactive">المعطلة</option>
            </select>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="text-muted mt-3">جاري تحميل المواد...</p>
        </div>
    }
    else if (!FilteredItems.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-box-seam fs-1 text-secondary"></i>
                <h5 class="mt-3">لا توجد مواد مطابقة</h5>
                <p class="text-muted small mb-0">
                    أضف مادة جديدة أو غيّر البحث.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in FilteredItems)
            {
                <div class="col-12 col-md-6 col-xl-4" @key="item.Id">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                                    <i class="bi bi-box-seam fs-4"></i>
                                </div>

                                <span class="badge rounded-pill @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "فعال" : "معطل")
                                </span>
                            </div>

                            <h5 class="fw-bold">@item.Name</h5>

                            <p class="text-muted small mb-3">
                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "لا يوجد وصف"
                                    : item.Description)
                            </p>

                            @if (isAdmin)
                            {
                                <div class="border-top pt-3">
                                    <button class="btn btn-outline-primary btn-sm rounded-3"
                                            @onclick="() => OpenEdit(item)">
                                        <i class="bi bi-pencil-square ms-1"></i>
                                        تعديل المادة
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showEditor)
    {
        <div class="items-backdrop" @onclick="CloseEditor">
            <div class="items-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-label="بيانات المادة"
                 @onclick:stopPropagation="true">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">
                        @(editingId is null ? "إضافة مادة" : "تعديل المادة")
                    </h5>

                    <button class="btn-close"
                            type="button"
                            aria-label="إغلاق"
                            @onclick="CloseEditor"></button>
                </div>

                <EditForm Model="@form"
                          OnValidSubmit="SaveAsync"
                          FormName="item-form">

                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">اسم المادة *</label>
                        <InputText class="form-control"
                                   @bind-Value="form.Name" />
                        <ValidationMessage For="@(() => form.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">الوصف</label>
                        <InputTextArea class="form-control"
                                       rows="3"
                                       @bind-Value="form.Description" />
                        <ValidationMessage For="@(() => form.Description)" />
                    </div>

                    <div class="form-check mb-4">
                        <InputCheckbox class="form-check-input"
                                       @bind-Value="form.IsActive" />
                        <label class="form-check-label">المادة فعالة</label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(saveError))
                    {
                        <div class="alert alert-danger">@saveError</div>
                    }

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button"
                                class="btn btn-light rounded-3"
                                disabled="@saving"
                                @onclick="CloseEditor">
                            إلغاء
                        </button>

                        <button type="submit"
                                class="btn btn-primary rounded-3"
                                disabled="@saving">
                            @(saving ? "جاري الحفظ..." : "حفظ المادة")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<ItemDto> items = new();
    private SaveItemRequest form = new();

    private bool loading = true;
    private bool saving;
    private bool isAdmin;
    private bool showEditor;

    private int? editingId;
    private string search = "";
    private string filter = "all";
    private string? error;
    private string? saveError;

    private IEnumerable<ItemDto> FilteredItems =>
        items.Where(x =>
            (filter == "all" ||
             (filter == "active" && x.IsActive) ||
             (filter == "inactive" && !x.IsActive)) &&
            (string.IsNullOrWhiteSpace(search) ||
             x.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ||
             (x.Description?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)))
        .OrderBy(x => x.Name);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        isAdmin = state.User.IsInRole("Admin");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            items = await ItemService.GetAllAsync();
        }
        catch
        {
            error = "تعذر تحميل المواد من السيرفر.";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCreate()
    {
        if (!isAdmin) return;

        editingId = null;
        form = new SaveItemRequest();
        saveError = null;
        showEditor = true;
    }

    private void OpenEdit(ItemDto item)
    {
        if (!isAdmin) return;

        editingId = item.Id;
        form = new SaveItemRequest
        {
            Name = item.Name,
            Description = item.Description,
            IsActive = item.IsActive
        };

        saveError = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        if (saving) return;
        showEditor = false;
    }

    private async Task SaveAsync()
    {
        if (!isAdmin || saving) return;

        saving = true;
        saveError = null;

        try
        {
            if (editingId.HasValue)
                await ItemService.UpdateAsync(editingId.Value, form);
            else
                await ItemService.CreateAsync(form);

            showEditor = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
