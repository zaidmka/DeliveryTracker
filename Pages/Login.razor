@page "/login"

@using System.ComponentModel.DataAnnotations
@using DeliveryTracker.Services.Auth

@inject IAuthService Auth
@inject NavigationManager Nav

<PageTitle>تسجيل الدخول - Delivery Tracker</PageTitle>

<div class="container d-flex align-items-center justify-content-center"
     style="min-height: 85vh;"
     dir="rtl">

    <div class="card border-0 shadow-sm w-100"
         style="max-width: 420px; border-radius: 16px;">

        <div class="card-body p-4 p-md-5">

           
            <div class="text-center mb-4">

                <div class="login-truck-icon mx-auto mb-3">
                    <i class="bi bi-truck"></i>
                </div>

                <h3 class="fw-bold mb-2">
                    Delivery Tracker
                </h3>

                <p class="text-muted mb-0">
                    تسجيل الدخول إلى نظام متابعة التوزيع
                </p>

            </div>


            <EditForm Model="@model"
                      OnValidSubmit="LoginAsync">

                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        اسم المستخدم
                    </label>

                    <InputText class="form-control"
                               autocomplete="username"
                               placeholder="أدخل اسم المستخدم"
                               @bind-Value="model.Username" />

                    <ValidationMessage For="@(() => model.Username)"
                                       class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        كلمة المرور
                    </label>

                    <InputText type="password"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="أدخل كلمة المرور"
                               @bind-Value="model.Password" />

                    <ValidationMessage For="@(() => model.Password)"
                                       class="text-danger small" />
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger"
                         role="alert">
                        @error
                    </div>
                }

                <button type="submit"
                        class="btn btn-primary w-100 py-2 mt-2"
                        disabled="@loading">

                    @if (loading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              aria-hidden="true"></span>
                        <span>جاري تسجيل الدخول...</span>
                    }
                    else
                    {
                        <span>تسجيل الدخول</span>
                    }

                </button>

            </EditForm>

        </div>
    </div>
</div>

@code {
    private LoginModel model = new();

    private bool loading = false;
    private string? error;

    private async Task LoginAsync()
    {
        if (loading)
            return;

        loading = true;
        error = null;

        try
        {
            bool success = await Auth.LoginAsync(
                model.Username.Trim(),
                model.Password);

            if (success)
            {
                Nav.NavigateTo("/", forceLoad: true);
            }
            else
            {
                error = "اسم المستخدم أو كلمة المرور غير صحيحة، أو الحساب مقفل مؤقتاً.";
            }
        }
        catch (HttpRequestException)
        {
            error = "تعذر الاتصال بالسيرفر. يرجى المحاولة لاحقاً.";
        }
        catch (Exception)
        {
            error = "حدث خطأ أثناء تسجيل الدخول. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            loading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "يرجى إدخال اسم المستخدم")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "يرجى إدخال كلمة المرور")]
        public string Password { get; set; } = string.Empty;
    }
}
