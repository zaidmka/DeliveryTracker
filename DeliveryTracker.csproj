<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <UserSecretsId>f22a0876-b844-4d78-a8ac-bb873ea28035</UserSecretsId>
	  <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <None Include="wwwroot\DeliveryLayout.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Supabase" Version="8.4.0" />
    <PackageReference Include="Supabase.Extensions.DependencyInjection" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Shared\DeliveryTracker.Shared.csproj" />
  </ItemGroup>
	<ItemGroup>
		<Compile Remove="Server\**\*.cs" />
		<Compile Remove="Shared\**\*.cs" />

		<Content Remove="Server\**" />
		<Content Remove="Shared\**" />

		<None Remove="Server\**" />
		<None Remove="Shared\**" />

		<EmbeddedResource Remove="Server\**" />
		<EmbeddedResource Remove="Shared\**" />
	</ItemGroup>
</Project>

